{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noteforge",
  "version": "0.1.0",
  "identifier": "de.noteforge.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Noteforge",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Noteforge",
    "category": "Education",
    "shortDescription": "Stiftoptimierte Schul-Notizen",
    "longDescription": "Noteforge – Notizen mit Stift für die Schule: Fächer, Blätter, Kalender, WebUntis/Moodle und Nextcloud-Sync.",
    "copyright": "© 2026 Noteforge",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "compression": "lzma"
      },
      "wix": {
        "language": "de-DE"
      }
    }
  }
}
